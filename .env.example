# LLM providers. Tried in LLM_PROVIDER_ORDER; a provider with no key is skipped (and listed as skipped).
LLM_PROVIDER_ORDER=gemini,openrouter,mistral
# any = fail over on every error (default). transient = only on network errors, timeouts, 408, 429, 5xx.
LLM_FAILOVER=any
GEMINI_API_KEY=your-gemini-key-here
# GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=   (optional; defaults to openrouter/auto, which picks a model per prompt)
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# Old name still accepted as the Gemini key: LLM_API_KEY

# Stats providers (optional; without them tier criteria show "not verifiable")
FOOTBALL_DATA_API_KEY=
API_FOOTBALL_KEY=

# Database (Supabase or Neon Postgres)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Protects cron and manual refresh routes
CRON_SECRET=change-me
