# Postgres connection (Neon / Supabase / local). Leave empty for in-memory store.
DATABASE_URL=

# Optional server-side LLM keys (used only if the client does not supply its own).
# Prefer letting each user enter their own keys in the Settings modal.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Optional football data providers (same rule: client keys take precedence)
FOOTBALL_DATA_API_KEY=
API_FOOTBALL_KEY=

# LLM routing
LLM_FAILOVER=
LLM_PROVIDER_ORDER=

# football-data.org free tier: 10 requests/minute
FOOTBALL_DATA_RATE_PER_MIN=9
FOOTBALL_DATA_MAX_CALLS_PER_RUN=60

# Protect admin / cron routes in production
CRON_SECRET=
