+++ b/tests/add-picks.test.ts
@@ -0,0 +1,60 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { planAdd, describeReport, type Revalidation } from '../src/lib/add-picks.ts';
+import { emptySlip, MAX_LEGS } from '../src/lib/slip.ts';
+import type { AiPick } from '../src/lib/ai-picks.ts';
+
+function pick(i: number, o: Partial<AiPick> = {}): AiPick {
+  return {
+    id: `p${i}`, gameId: `sportybet:ev${i}`, bookmaker: 'sportybet', marketKey: 'over_1_5', marketNativeId: 'm', outcomeNativeId: 'o',
+    specifier: '', odds: 1.3, impliedProbability: 0.7, kickoff: 1, league: 'L', home: `H${i}`, away: `A${i}`, tier: 'safe',
+    evaluation: { qualifies: true, label: 'Best fit', passed: 1, verifiable: 1, total: 1, verifiedLabel: '', reason: null, provisionalCriteria: [] },
+    fitScore: 0.5, fitBreakdown: {} as AiPick['fitBreakdown'], rationale: '', exclusionStatus: 'not_checked', ...o,
+  };
+}
+
+test('adds exactly N, in order', () => {
+  const r = planAdd([1, 2, 3, 4, 5].map((i) => pick(i)), emptySlip(), 3);
+  assert.equal(r.report.added, 3);
+  assert.deepEqual(r.slip.legs.map((l) => l.gameId), ['sportybet:ev1', 'sportybet:ev2', 'sportybet:ev3']);
+});
+
+test('skips games already on the slip and keeps scanning so N is still reached', () => {
+  const first = planAdd([pick(1)], emptySlip(), 1).slip;
+  const r = planAdd([pick(1, { id: 'dup' }), pick(2), pick(3)], first, 2);
+  assert.equal(r.report.added, 2);
+  assert.equal(r.report.skipped.length, 1);
+  assert.match(r.report.skipped[0].reason, /already in the slip/);
+});
+
+test('refuses a different bookmaker than the slip, and says why', () => {
+  const first = planAdd([pick(1)], emptySlip(), 1).slip;
+  const r = planAdd([pick(2, { bookmaker: 'betpawa', gameId: 'betpawa:ev2' })], first, 1);
+  assert.equal(r.report.added, 0);
+  assert.match(r.report.skipped[0].reason, /sportybet/);
+});
+
+test('never goes past the leg cap', () => {
+  const many = Array.from({ length: MAX_LEGS + 10 }, (_, i) => pick(i));
+  const r = planAdd(many, emptySlip(), MAX_LEGS + 10);
+  assert.equal(r.slip.legs.length, MAX_LEGS);
+  assert.equal(r.report.added, MAX_LEGS);
+});
+
+test('re-validation: price change is applied and reported, dropped picks are skipped', () => {
+  const reval = new Map<string, Revalidation>([
+    ['p1', { flag: { kind: 'price_changed', oldOdds: 1.3, newOdds: 1.35, stillInBand: true }, odds: 1.35 }],
+    ['p2', { flag: { kind: 'no_longer_qualifies', reason: 'Odds moved to 2.00, outside the safe band' }, odds: 2 }],
+    ['p3', { flag: { kind: 'market_gone', reason: 'Market no longer listed' }, odds: 1.3 }],
+  ]);
+  const r = planAdd([pick(1), pick(2), pick(3), pick(4)], emptySlip(), 3, reval);
+  assert.equal(r.report.added, 2);
+  assert.equal(r.slip.legs[0].odds, 1.35);
+  assert.equal(r.report.priceChanged.length, 1);
+  assert.deepEqual(r.report.skipped.map((s) => s.id), ['p2', 'p3']);
+});
+
+test('asking for more than exist reports "X of N"', () => {
+  const r = planAdd([pick(1), pick(2)], emptySlip(), 5);
+  assert.equal(describeReport(r.report), 'Added 2 of 5.');
+});
diff --git a/tests/alternatives.test.ts b/tests/alternatives.test.ts
new file mode 100644
index 0000000..1100942
--- /dev/null
+++ b/tests/alternatives.test.ts
@@ -0,0 +1,127 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { generateAlternatives, swapInSlip, mulberry32, signature } from '../src/lib/alternatives.ts';
+import type { AiPick } from '../src/lib/ai-picks.ts';
+import type { PickMarketKey, Tier } from '../src/lib/criteria.ts';
+
+const MARKETS: PickMarketKey[] = ['home_win', 'over_1_5', 'under_3_5', 'under_4_5', 'over_0_5', 'away_win'];
+const TIERS: Tier[] = ['safe', 'balanced', 'value'];
+
+/** nGames games, each offering `perGame` different markets, with deterministic odds and fit. */
+function makePool(nGames: number, perGame = 3, seed = 7): AiPick[] {
+  const r = mulberry32(seed);
+  const out: AiPick[] = [];
+  for (let g = 0; g < nGames; g++) {
+    for (let m = 0; m < perGame; m++) {
+      const odds = Math.round((1.15 + r() * 0.9) * 100) / 100;
+      const key = MARKETS[(g + m) % MARKETS.length];
+      out.push({
+        id: `g${g}:${key}:t`, gameId: `sportybet:g${g}`, bookmaker: 'sportybet', marketKey: key,
+        marketNativeId: 'm', outcomeNativeId: 'o', specifier: '', odds, impliedProbability: 1 / odds,
+        kickoff: 1_000 + g, league: 'Premier League', home: `H${g}`, away: `A${g}`,
+        tier: TIERS[Math.floor(r() * 3)], fitScore: 0.4 + r() * 0.3, fitBreakdown: {} as AiPick['fitBreakdown'],
+        evaluation: { qualifies: true, label: r() > 0.5 ? 'Verified' : 'Best fit', passed: 2, verifiable: 2, total: 3, verifiedLabel: '', reason: null, provisionalCriteria: [] },
+        rationale: '', exclusionStatus: 'not_checked',
+      });
+    }
+  }
+  return out;
+}
+
+const tot = (p: AiPick[]) => p.reduce((a, x) => a * x.odds, 1);
+
+test('alternatives: many distinct slips, all inside the odds band, one pick per game', () => {
+  const pool = makePool(60);
+  const band = { min: 180, max: 220 };
+  const r = generateAlternatives(pool, { band, maxSlips: 40, minDiffLegs: 2 });
+  assert.ok(r.slips.length >= 25, `expected at least 25 slips, got ${r.slips.length}`);
+  const sigs = new Set<string>();
+  for (const s of r.slips) {
+    const t = tot(s.picks);
+    assert.ok(t >= band.min && t <= band.max, `total ${t} outside band`);
+    assert.equal(new Set(s.picks.map((p) => p.gameId)).size, s.picks.length, 'one pick per game');
+    sigs.add(signature(s.picks));
+  }
+  assert.equal(sigs.size, r.slips.length, 'no duplicate slips');
+});
+
+test('alternatives: every pair differs by at least minDiffLegs', () => {
+  const r = generateAlternatives(makePool(60), { band: { min: 90, max: 110 }, maxSlips: 30, minDiffLegs: 3 });
+  for (let i = 0; i < r.slips.length; i++) for (let j = i + 1; j < r.slips.length; j++) {
+    const ids = new Set(r.slips[j].picks.map((p) => p.id));
+    assert.ok(r.slips[i].picks.filter((p) => !ids.has(p.id)).length >= 3);
+  }
+});
+
+test('alternatives: deterministic, and a larger count extends the same list', () => {
+  const pool = makePool(60);
+  const a = generateAlternatives(pool, { band: { min: 180, max: 220 }, maxSlips: 10, seed: 5 });
+  const b = generateAlternatives(pool, { band: { min: 180, max: 220 }, maxSlips: 10, seed: 5 });
+  const c = generateAlternatives(pool, { band: { min: 180, max: 220 }, maxSlips: 20, seed: 5 });
+  assert.deepEqual(a.slips.map((s) => s.id), b.slips.map((s) => s.id));
+  assert.deepEqual(c.slips.slice(0, 10).map((s) => s.id), a.slips.map((s) => s.id));
+});
+
+test('alternatives: cross-market swaps happen, and same_market keeps each swap in its market', () => {
+  const pool = makePool(60);
+  const any = generateAlternatives(pool, { band: { min: 180, max: 220 }, maxSlips: 20, scope: 'any' });
+  const markets = new Set(any.slips.flatMap((s) => s.picks.map((p) => p.marketKey)));
+  assert.ok(markets.size > 1);
+});
+
+test('alternatives: locked games stay in every slip', () => {
+  const pool = makePool(60);
+  const first = generateAlternatives(pool, { band: { min: 180, max: 220 }, maxSlips: 1 });
+  const locked = first.slips[0].picks.slice(0, 2).map((p) => p.gameId);
+  const r = generateAlternatives(pool, { band: { min: 180, max: 220 }, maxSlips: 15, lockedGameIds: locked });
+  for (const s of r.slips) for (const g of locked) assert.ok(s.picks.some((p) => p.gameId === g));
+});
+
+test('alternatives: reports exhaustion honestly on a small pool', () => {
+  const r = generateAlternatives(makePool(14, 1), { band: { min: 8, max: 16 }, maxSlips: 500, minDiffLegs: 2 });
+  assert.equal(r.exhausted, true);
+  assert.match(r.message ?? '', /exhausted|closest|No qualifying/i);
+});
+
+test('alternatives: unreachable target says so instead of faking a slip', () => {
+  const r = generateAlternatives(makePool(5, 1), { band: { min: 5000, max: 6000 } });
+  assert.equal(r.slips.length, 0);
+  assert.match(r.message ?? '', /closest/);
+});
+
+test('swapInSlip: replaces weakest legs, never reuses excluded picks, keeps locked legs', () => {
+  const pool = makePool(40);
+  const slip = generateAlternatives(pool, { band: { min: 90, max: 110 }, maxSlips: 1 }).slips[0].picks;
+  const locked = [slip[0].gameId];
+  const seen = new Set<string>();
+  let cur = slip;
+  for (let i = 0; i < 4; i++) {
+    const r = swapInSlip(cur, pool, { weakest: 2, lockedGameIds: locked, excludeIds: [...seen] });
+    if (!r.ok) break;
+    for (const sw of r.swaps) {
+      assert.ok(!seen.has(sw.in.id), 'replacement repeated');
+      seen.add(sw.in.id);
+      assert.ok(sw.in.fitScore >= sw.out.fitScore - 0.05 - 1e-9);
+    }
+    assert.ok(r.picks.some((p) => p.gameId === locked[0]));
+    assert.equal(new Set(r.picks.map((p) => p.gameId)).size, r.picks.length);
+    cur = r.picks;
+  }
+  assert.ok(seen.size > 0);
+});
+
+test('swapInSlip: never downgrades a Verified leg to Best fit', () => {
+  const pool = makePool(40);
+  const slip = generateAlternatives(pool, { band: { min: 90, max: 110 }, maxSlips: 1 }).slips[0].picks;
+  const v = slip.find((p) => p.evaluation.label === 'Verified');
+  if (!v) return;
+  const r = swapInSlip(slip, pool, { replaceIds: [v.id] });
+  if (r.ok) assert.equal(r.swaps[0].in.evaluation.label, 'Verified');
+});
+
+test('swapInSlip: all legs locked gives a clear error', () => {
+  const pool = makePool(30);
+  const slip = generateAlternatives(pool, { band: { min: 40, max: 60 }, maxSlips: 1 }).slips[0].picks;
+  const r = swapInSlip(slip, pool, { weakest: 2, lockedGameIds: slip.map((p) => p.gameId) });
+  assert.equal(r.ok, false);
+});
diff --git a/tests/data-status.test.ts b/tests/data-status.test.ts
new file mode 100644
index 0000000..5058d83
--- /dev/null
+++ b/tests/data-status.test.ts
@@ -0,0 +1,100 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { generateAiPicks } from '../src/lib/ai-engine.ts';
+import { evaluateCriteria, type CriterionResult } from '../src/lib/evaluator.ts';
+import { computeFitScore } from '../src/lib/ai-picks.ts';
+import { configuredProviders } from '../src/lib/stats.ts';
+import type { Game } from '../src/lib/types.ts';
+
+function game(id: string, league: string, home: string, away: string, odds = 1.35): Game {
+  return {
+    id: `sportybet:${id}`, bookmaker: 'sportybet', nativeEventId: id, home, away, kickoff: Date.parse('2026-11-02T15:00:00Z'),
+    league, fetchRunId: 'r1',
+    markets: [{
+      bookmaker: 'sportybet', nativeId: 'm1', specifier: '', line: null, kind: '1x2', unavailableReason: null,
+      outcomes: [
+        { bookmaker: 'sportybet', nativeId: '1', desc: '1', odds, isActive: true },
+        { bookmaker: 'sportybet', nativeId: '2', desc: 'X', odds: 4.2, isActive: true },
+        { bookmaker: 'sportybet', nativeId: '3', desc: '2', odds: 7.5, isActive: true },
+      ],
+    }],
+  };
+}
+
+const KEY = 'FOOTBALL_DATA_API_KEY';
+
+test('without an API key every missing criterion says not_fetched and names the fix', async () => {
+  const saved = process.env[KEY];
+  delete process.env[KEY];
+  try {
+    const r = await generateAiPicks([game('1', 'Premier League', 'Arsenal', 'Chelsea')]);
+    assert.ok(r.statsNote);
+    assert.equal(r.coverage.byState.ok, 0);
+    assert.ok(r.coverage.byState.not_fetched > 0);
+    assert.match(r.coverage.topReasons[0].reason, /FOOTBALL_DATA_API_KEY/);
+    const pick = r.picks[0];
+    assert.ok(pick.criteria && pick.criteria.every((c) => c.dataState === 'not_fetched'));
+    assert.equal(pick.evaluation.dataCoverage, 0);
+  } finally {
+    if (saved !== undefined) process.env[KEY] = saved;
+  }
+});
+
+test('with a key, real values are compared and marked ok; uncovered leagues say not_covered', async () => {
+  const savedKey = process.env[KEY];
+  const savedFetch = globalThis.fetch;
+  process.env[KEY] = 'test-key-engine';
+  const row = (id: number, name: string, pos: number) => ({ position: pos, team: { id, name }, playedGames: 10, won: 8, draw: 1, lost: 1, goalsFor: 20, goalsAgainst: 5 });
+  const table = [row(1, 'Arsenal FC', 1), row(2, 'Chelsea FC', 2)];
+  const ms = [1, 2, 3, 4, 5].map((i) => ({ utcDate: `2026-09-0${i}T15:00:00Z`, status: 'FINISHED', homeTeam: { id: 1 }, awayTeam: { id: 9 }, score: { fullTime: { home: 2, away: 0 } } }));
+  globalThis.fetch = (async (url: string) => ({
+    status: 200, ok: true,
+    json: async () => (String(url).includes('/standings')
+      ? { standings: [{ type: 'TOTAL', table }, { type: 'HOME', table }, { type: 'AWAY', table }] }
+      : { matches: ms }),
+  })) as unknown as typeof fetch;
+  try {
+    configuredProviders({ ...process.env, [KEY]: 'test-key-engine' }); // build the provider with the mocked fetch
+    const r = await generateAiPicks([
+      game('1', 'Premier League', 'Arsenal', 'Chelsea'),
+      game('2', 'Kenya Premier League', 'Gor Mahia', 'AFC Leopards'),
+    ]);
+    const epl = r.picks.find((p) => p.league === 'Premier League')!;
+    const ken = r.picks.find((p) => p.league === 'Kenya Premier League')!;
+    assert.ok(epl.criteria!.some((c) => c.dataState === 'ok' && c.status === 'pass'));
+    assert.ok(epl.evaluation.dataCoverage! > 0.5);
+    assert.ok(ken.criteria!.every((c) => c.dataState === 'not_covered'));
+    assert.match(ken.criteria![0].detail ?? '', /not one of the free/);
+    assert.ok(epl.evaluation.dataCoverage! > ken.evaluation.dataCoverage!);
+  } finally {
+    globalThis.fetch = savedFetch;
+    if (savedKey === undefined) delete process.env[KEY]; else process.env[KEY] = savedKey;
+  }
+});
+
+test('evaluator counts data states and coverage', () => {
+  const res: CriterionResult[] = [
+    { id: 'a', label: 'a', status: 'pass', dataState: 'ok' },
+    { id: 'b', label: 'b', status: 'fail', dataState: 'ok' },
+    { id: 'c', label: 'c', status: 'unavailable', dataState: 'not_offered' },
+    { id: 'd', label: 'd', status: 'unavailable', dataState: 'fetch_failed' },
+    { id: 'e', label: 'e', status: 'unavailable' },
+  ];
+  const ev = evaluateCriteria(res);
+  assert.equal(ev.dataCoverage, 2 / 5);
+  assert.deepEqual(ev.stateCounts, { ok: 2, not_offered: 1, not_covered: 0, not_fetched: 1, fetch_failed: 1, not_configured: 0 });
+});
+
+test('less data weights the bookmaker probability more', () => {
+  const mk = (coverage: number) => ({
+    qualifies: true, label: 'Best fit' as const, passed: 0, verifiable: 0, total: 4, verifiedLabel: '', reason: null,
+    provisionalCriteria: [], dataCoverage: coverage,
+  });
+  const high = computeFitScore({ oddsInBand: true, impliedProbability: 0.8, evaluation: mk(0), league: 'Premier League', hasCardsOrCornersData: false, congestionFlag: false });
+  const lowProb = computeFitScore({ oddsInBand: true, impliedProbability: 0.5, evaluation: mk(0), league: 'Premier League', hasCardsOrCornersData: false, congestionFlag: false });
+  const full = computeFitScore({ oddsInBand: true, impliedProbability: 0.8, evaluation: mk(1), league: 'Premier League', hasCardsOrCornersData: false, congestionFlag: false });
+  assert.ok(high.score - lowProb.score > full.score - computeFitScore({ oddsInBand: true, impliedProbability: 0.5, evaluation: mk(1), league: 'Premier League', hasCardsOrCornersData: false, congestionFlag: false }).score,
+    'with no data, a higher probability should be rewarded more than with full data');
+  assert.ok(high.breakdown.lowDataProbability! > 0);
+  assert.equal(full.breakdown.lowDataProbability, 0);
+});
diff --git a/tests/football-data.test.ts b/tests/football-data.test.ts
new file mode 100644
index 0000000..7eb099f
--- /dev/null
+++ b/tests/football-data.test.ts
@@ -0,0 +1,148 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { FootballDataProvider } from '../src/lib/fd-provider.ts';
+import { competitionCodeFor } from '../src/lib/competitions.ts';
+import type { MetricRequest } from '../src/lib/stats-types.ts';
+
+const row = (id: number, name: string, position: number, played: number, won: number, draw: number, gf: number, ga: number) => ({
+  position, team: { id, name }, playedGames: played, won, draw, lost: played - won - draw, goalsFor: gf, goalsAgainst: ga,
+});
+const STANDINGS = {
+  standings: [
+    { type: 'TOTAL', table: [row(1, 'Arsenal FC', 1, 10, 8, 1, 24, 6), row(2, 'Chelsea FC', 6, 10, 4, 3, 14, 12)] },
+    { type: 'HOME', table: [row(1, 'Arsenal FC', 1, 5, 5, 0, 14, 2), row(2, 'Chelsea FC', 4, 5, 3, 1, 8, 4)] },
+    { type: 'AWAY', table: [row(1, 'Arsenal FC', 2, 5, 3, 1, 10, 4), row(2, 'Chelsea FC', 9, 5, 1, 2, 6, 8)] },
+  ],
+};
+const m = (date: string, homeId: number, awayId: number, h: number, a: number) => ({
+  utcDate: date, status: 'FINISHED', homeTeam: { id: homeId }, awayTeam: { id: awayId }, score: { fullTime: { home: h, away: a } },
+});
+// Arsenal (id 1): W 2-0, D 1-1, W 3-1 (away), L 0-1, W 4-0  -> form 3+1+3+0+3 = 10
+const MATCHES = { matches: [
+  m('2026-09-01T15:00:00Z', 1, 9, 2, 0), m('2026-09-08T15:00:00Z', 9, 1, 1, 1), m('2026-09-15T15:00:00Z', 9, 1, 1, 3),
+  m('2026-09-22T15:00:00Z', 1, 9, 0, 1), m('2026-09-29T15:00:00Z', 1, 9, 4, 0),
+] };
+
+function setup(opts: { status?: number; maxCalls?: number } = {}) {
+  const calls: string[] = [];
+  const fetchImpl = (async (url: string) => {
+    calls.push(String(url));
+    const status = opts.status ?? 200;
+    const body = String(url).includes('/standings') ? STANDINGS : MATCHES;
+    return { status, ok: status >= 200 && status < 300, json: async () => body } as Response;
+  }) as unknown as typeof fetch;
+  const now = { t: Date.parse('2026-10-01T12:00:00Z') };
+  const p = new FootballDataProvider(
+    { FOOTBALL_DATA_API_KEY: 'k', FOOTBALL_DATA_MAX_CALLS_PER_RUN: String(opts.maxCalls ?? 60) } as unknown as NodeJS.ProcessEnv,
+    { fetch: fetchImpl, now: () => now.t, sleep: async (ms) => { now.t += ms; } },
+  );
+  return { p, calls, now };
+}
+const req = (metric: string, o: Partial<MetricRequest> = {}): MetricRequest =>
+  ({ metric, league: 'Premier League', home: 'Arsenal', away: 'Chelsea', side: 'home', window: 5, ...o });
+
+test('league name mapping is exact: other countries are never mistaken for the English league', () => {
+  assert.equal(competitionCodeFor('Premier League'), 'PL');
+  assert.equal(competitionCodeFor('England Premier League'), 'PL');
+  assert.equal(competitionCodeFor('Egypt Premier League'), null);
+  assert.equal(competitionCodeFor('Brazil Serie A'), 'BSA');
+  assert.equal(competitionCodeFor('Kenya Premier League'), null);
+});
+
+test('standings metrics: home win rate, unbeaten rate, rank, goals', async () => {
+  const { p } = setup();
+  const get = async (metric: string, o: Partial<MetricRequest> = {}) => {
+    const r = await p.fetch(req(metric, o));
+    assert.ok(r.ok, JSON.stringify(r));
+    return r.value;
+  };
+  assert.equal(await get('home_win_rate'), 1);
+  assert.equal(await get('unbeaten_home_rate'), 1);
+  assert.equal(await get('away_win_rate', { side: 'away' }), 0.2);
+  assert.equal(await get('league_rank'), 1);
+  assert.equal(await get('goals_scored_avg'), 2.4);
+  assert.equal(await get('goals_conceded_avg', { side: 'both' }), 0.9); // (0.6 + 1.2) / 2
+});
+
+test('match metrics: form points, rest days, goal-line rates', async () => {
+  const { p } = setup();
+  const val = async (metric: string, o: Partial<MetricRequest> = {}) => {
+    const r = await p.fetch(req(metric, o));
+    assert.ok(r.ok, JSON.stringify(r));
+    return r.value;
+  };
+  assert.equal(await val('form_points'), 10);
+  assert.equal(await val('over_1_5_rate'), 0.8);          // 2,2,4,1,4 goals -> 4 of 5 are 2+
+  assert.equal(await val('under_3_5_rate'), 0.6);         // 2,2,4,1,4 -> 3 of 5 are <=3
+  assert.equal(await val('no_draw_rate'), 0.8);
+  // last match 2026-09-29 15:00, kickoff 2026-10-03 15:00 -> 4 days
+  assert.equal(await val('rest_days', { kickoff: Date.parse('2026-10-03T15:00:00Z') }), 4);
+});
+
+test('results are cached: a second metric for the same team makes no new requests', async () => {
+  const { p, calls } = setup();
+  await p.fetch(req('form_points'));
+  const n = calls.length;
+  await p.fetch(req('over_1_5_rate'));
+  await p.fetch(req('home_win_rate'));
+  assert.equal(calls.length, n);
+});
+
+test('no key -> not_fetched with the fix named', async () => {
+  const p = new FootballDataProvider({} as unknown as NodeJS.ProcessEnv);
+  const r = await p.fetch(req('form_points'));
+  assert.ok(!r.ok && r.state === 'not_fetched');
+  assert.match((r as { reason: string }).reason, /FOOTBALL_DATA_API_KEY/);
+});
+
+test('league outside the free competitions -> not_covered', async () => {
+  const { p, calls } = setup();
+  const r = await p.fetch(req('form_points', { league: 'Kenya Premier League' }));
+  assert.ok(!r.ok && r.state === 'not_covered');
+  assert.equal(calls.length, 0, 'no request should be made for an uncovered league');
+});
+
+test('team that cannot be matched -> not_covered, with the name', async () => {
+  const { p } = setup();
+  const r = await p.fetch(req('form_points', { home: 'Zzyzx Rovers' }));
+  assert.ok(!r.ok && r.state === 'not_covered');
+  assert.match((r as { reason: string }).reason, /Zzyzx Rovers/);
+});
+
+test('HTTP 429 -> fetch_failed, 403 -> not_offered, and neither is retried', async () => {
+  const a = setup({ status: 429 });
+  const r1 = await a.p.fetch(req('league_rank'));
+  assert.ok(!r1.ok && r1.state === 'fetch_failed');
+  assert.match((r1 as { reason: string }).reason, /429/);
+  const b = setup({ status: 403 });
+  const r2 = await b.p.fetch(req('league_rank'));
+  assert.ok(!r2.ok && r2.state === 'not_offered');
+  assert.equal(a.calls.length, 1);
+});
+
+test('per-run request budget -> not_fetched, and beginRun resets it', async () => {
+  const { p } = setup({ maxCalls: 1 });
+  const first = await p.fetch(req('league_rank'));   // uses the one standings call
+  assert.ok(first.ok);
+  const second = await p.fetch(req('form_points'));  // needs a team-matches call: over budget
+  assert.ok(!second.ok && second.state === 'not_fetched');
+  assert.match((second as { reason: string }).reason, /budget/);
+  p.beginRun();
+  const third = await p.fetch(req('form_points'));
+  assert.ok(third.ok);
+});
+
+test('rate limit: never more than the allowed requests per rolling minute', async () => {
+  const { p, now } = setup();
+  const starts: number[] = [];
+  const orig = (p as unknown as { fetchImpl: typeof fetch }).fetchImpl;
+  (p as unknown as { fetchImpl: typeof fetch }).fetchImpl = (async (...a: Parameters<typeof fetch>) => { starts.push(now.t); return orig(...a); }) as typeof fetch;
+  (p as unknown as { ratePerMin: number }).ratePerMin = 2;
+  for (const name of ['Arsenal', 'Chelsea']) {
+    await p.fetch(req('form_points', { home: name, side: 'home' }));
+    p.beginRun();
+  }
+  // 1 standings + 2 team calls = 3 requests, only 2 may start in the first minute
+  assert.equal(starts.length, 3);
+  assert.ok(starts[2] - starts[0] >= 60_000, `third call started ${starts[2] - starts[0]}ms after the first`);
+});
