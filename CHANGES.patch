+  }
+
+  async function swap(r: Row, mode: 'weakest' | 'picked') {
+    const l = loc(r);
+    const body = {
+      pickIds: l.picks.map((p) => p.id), lockedGameIds: l.locked, excludeIds: [...l.seen, ...l.picks.map((p) => p.id)],
